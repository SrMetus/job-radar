# Copy to .env and replace placeholders. Never commit .env.
POSTGRES_DB=job_radar
POSTGRES_USER=job_radar
POSTGRES_PASSWORD=<choose-a-local-password>

# Match the database/user/password above. URL-encode credentials in this URL.
# Docker uses the service hostname db; use localhost for a separate local database.
DATABASE_URL=postgresql+psycopg://job_radar:<url-encoded-password>@db:5432/job_radar

# Remotive public JSON API; no API key. Fetch infrequently (max. 4 times/day advised).
EXTERNAL_JOB_SOURCE_URL=https://remotive.com/api/remote-jobs?category=software-dev&limit=20
